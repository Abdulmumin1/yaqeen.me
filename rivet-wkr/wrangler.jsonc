/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yaqeen-garden-do",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-21",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": [
				"ActorHandler"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ActorHandler",
				"name": "ACTOR_DO"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
    {
      "binding": "ACTOR_KV",
      "id": "956dac8fa711487db7b2cfebdd48b375"
    }
  ]
}